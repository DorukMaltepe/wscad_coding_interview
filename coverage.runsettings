<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage for the unit and integration tests in CI. Uses Microsoft.CodeCoverage, which Microsoft.NET.Test.Sdk already brings. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <CodeCoverage>
            <ModulePaths>
              <!-- Measure product code only; test assemblies would inflate the numbers. -->
              <Exclude>
                <ModulePath>.*Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
