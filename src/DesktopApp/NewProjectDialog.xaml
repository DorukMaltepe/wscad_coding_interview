<Window x:Class="DesktopApp.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=ProjectNameInput}">
    <StackPanel Margin="12">
        <Label Content="_Project name" Target="{Binding ElementName=ProjectNameInput}" />
        <TextBox x:Name="ProjectNameInput" />
        <Label Content="_Customer" Target="{Binding ElementName=CustomerInput}" />
        <TextBox x:Name="CustomerInput" />
        <Label Content="_Standard" Target="{Binding ElementName=StandardCombo}" />
        <ComboBox x:Name="StandardCombo" SelectedIndex="0">
            <ComboBoxItem Content="IEC 81346" />
            <ComboBoxItem Content="NFPA 79" />
        </ComboBox>
        <GroupBox Header="Page format" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Margin="4">
                <RadioButton x:Name="PageFormatA3Radio" Content="A3 landscape" IsChecked="True" />
                <RadioButton x:Name="PageFormatA4Radio" Content="A4 landscape" Margin="16,0,0,0" />
            </StackPanel>
        </GroupBox>
        <CheckBox x:Name="CoverSheetCheckBox" Content="Create c_over sheet" IsChecked="True" Margin="0,8,0,0" />
        <TextBlock x:Name="ValidationText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
