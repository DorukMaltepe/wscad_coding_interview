<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Real setup: replace with a single internal Azure Artifacts feed that has nuget.org as an
         upstream source (blocks dependency confusion). nuget.org is used here so the repo restores anywhere. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
